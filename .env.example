# Copy to .env and fill in locally. .env is gitignored — NEVER commit a real key.
# Meta Model API key. The client accepts MUSE_API_KEY (preferred) or META_API_KEY.
MUSE_API_KEY=
# Partner inference keys for paid red-team runs (human-owned; never commit).
# Baseten select offer: https://inference.baseten.co/v1, model meta-models/muse-spark-open-1026.
BASETEN_API_KEY=
# Fireworks (redteam default provider): set to use --provider fireworks.
FIREWORKS_API_KEY=
# Optional overrides (defaults shown):
# META_API_BASE=https://api.meta.ai
# MUSE_MODEL_COMPANION=muse-spark-1.3
# MUSE_MODEL_ARCHITECT=muse-wonder-1.0
