# dependencies
node_modules/

# build output (generated, disposable)
dist/

# harness state — single-owner, mostly gitignored; .fence/app-profile.json IS commitable (S-09, Task 2)
.fence/*
!.fence/app-profile.json
# explicitly ignored harness artefacts (also appended by installer on init)
.fence/.integrity.json
.fence/events.ndjson
.fence/state/
.fence/verdicts/
.fence/queue.json

# env / secrets
.env
.env.*
!.env.example

# editor / os
.DS_Store
*.swp
*.swo
.idea/
.vscode/settings.json

# internal tooling (hermes)
.hermes/

# bun / tooling caches
tools/out/
