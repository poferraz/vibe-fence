{
  "name": "vibe-fence",
  "version": "0.4.0",
  "description": "Local guardrails, secret checks, and a circuit breaker for AI coding agents",
  "type": "module",
  "license": "MIT",
  "author": "Paulo Ferraz <poferraz@me.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/poferraz/vibe-fence.git"
  },
  "homepage": "https://github.com/poferraz/vibe-fence#readme",
  "bugs": {
    "url": "https://github.com/poferraz/vibe-fence/issues"
  },
  "keywords": [
    "ai-agents",
    "guardrails",
    "vibe-coding",
    "claude-code",
    "muse-code",
    "cursor",
    "codex",
    "opencode",
    "secret-scanner",
    "git-hooks",
    "developer-tools"
  ],
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20",
    "bun": ">=1.0"
  },
  "files": [
    "dist/",
    "docs/assets/",
    "AGENTS.md",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "vibe-fence": "./dist/cli.js"
  },
  "scripts": {
    "build": "bun run tools/generate.ts",
    "validate": "bun run tools/validate.ts",
    "deploy": "bun run tools/install.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "eval": "bun run tools/eval.ts --check",
    "eval:baseline": "bun run tools/eval.ts --write-baseline"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  }
}
